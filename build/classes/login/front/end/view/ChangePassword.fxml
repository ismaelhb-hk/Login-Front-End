<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="540.0" prefWidth="620.0" style="-fx-background-color: #f4f6fb;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="login.front.end.view.ChangePasswordController">
   <children>
      <VBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-background-color: linear-gradient(to right, #4f46e5, #7c3aed);">
         <padding>
            <Insets bottom="28.0" left="40.0" right="40.0" top="28.0" />
         </padding>
         <children>
            <Label fx:id="titleLabel" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Cambiar contraseña" />
            <Label fx:id="subtitleLabel" style="-fx-text-fill: #e0e7ff; -fx-font-size: 14px;" text="Introduce tu contraseña actual y elige una nueva." />
         </children>
      </VBox>
      <VBox spacing="18.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label fx:id="currentPasswordLabel" style="-fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold;" text="Contraseña actual" />
                  <PasswordField fx:id="currentPasswordField" 
                                  prefHeight="42.0" promptText="Escribe tu contraseña actual" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-padding: 0 12 0 12;" />
               </children>
            </VBox>
            <VBox spacing="6.0">
               <children>
                  <Label fx:id="newPasswordLabel" style="-fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold;" text="Nueva contraseña" />
                  <PasswordField fx:id="newPasswordField" 
                                  prefHeight="42.0" promptText="Escribe la nueva contraseña" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-padding: 0 12 0 12;" />
               </children>
            </VBox>
            <VBox spacing="6.0">
               <children>
                  <Label fx:id="confirmPasswordLabel" style="-fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold;" text="Confirmar nueva contraseña" />
                  <PasswordField fx:id="confirmPasswordField" 
                                 prefHeight="42.0" promptText="Repite la nueva contraseña" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-background-color: white; -fx-padding: 0 12 0 12;" />
                  <Label fx:id="matchLabel" prefHeight="20.0" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
               </children>
            </VBox>
            <Label fx:id="messageLabel" style="-fx-font-size: 13px;" />
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" 
                          onAction="#handleCancel" prefHeight="42.0" prefWidth="130.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-font-size: 14px; -fx-cursor: hand;" text="Cancelar" />
                  <Button fx:id="changeButton" defaultButton="true" mnemonicParsing="false" 
                          onAction="#handleChangePassword" prefHeight="42.0" prefWidth="170.0" style="-fx-background-color: #4f46e5; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Cambiar contraseña" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
