<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="login.front.end.view.MainWindowController">
   <children>
      <VBox layoutX="447.0" prefHeight="400.0" prefWidth="154.0">
         <children>
            <Hyperlink fx:id="linkChangePassword" onAction="#handleChangePassword" text="Cambiar contraseña" />
            <Hyperlink fx:id="linkLogout" onAction="#handleLogout" text="Cerrar sesion" />
         </children>
      </VBox>
      <Button fx:id="btnThanks" layoutX="29.0" layoutY="275.0" mnemonicParsing="false" onAction="#handleThanks" prefHeight="94.0" prefWidth="198.0" text="Dar las Gracias al diseñador" />
      <Button fx:id="btnWelcome" layoutX="240.0" layoutY="275.0" mnemonicParsing="false" onAction="#handleWelcome" prefHeight="94.0" prefWidth="206.0" text="Panel bienvenida personalizado" />
      <Label fx:id="lblThanks" layoutY="94.0" prefHeight="33.0" prefWidth="114.0" />
      <Label fx:id="lblWelcome" layoutY="44.0" prefHeight="50.0" prefWidth="446.0" />
      <Label alignment="CENTER" layoutX="14.0" layoutY="6.0" prefHeight="50.0" prefWidth="414.0" text="Bienvenido" textFill="#a500ff">
         <font>
            <Font size="29.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
